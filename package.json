{
  "name": "speakmore",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421 --strictPort",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "node scripts/prepare-worker.mjs && tauri dev",
    "check": "npm run build && npm test && cargo test -p speakmore-models -p speakmore-core -p speakmore-protocol -p speakmore-audio -p speakmore-asr-worker -p speakmore-worker-supervisor -p speakmore-providers -p speakmore-license --features speakmore-worker-supervisor/test-fixtures && npm run test:session",
    "test:supervisor": "cargo test -p speakmore-worker-supervisor --features test-fixtures --test lifecycle",
    "test:asr:mac": "cargo test -p speakmore-asr-worker --features metal --test process real_supervisor_roundtrip_cancellation_and_five_minute_silence -- --ignored --nocapture --test-threads=1",
    "test:asr": "cargo test -p speakmore-asr-worker --test process real_ -- --ignored --nocapture --test-threads=1",
    "format": "prettier --write src vite.config.ts package.json tsconfig.json components.json src-tauri/*.json docs README.md && cargo fmt --all",
    "test:models": "cargo test -p speakmore-models --lib",
    "test:providers": "cargo test -p speakmore-providers",
    "test:clipboard:mac": "cargo test -p speakmore-desktop --lib clipboard::mac::tests -- --ignored",
    "test:input:mac": "cargo test -p speakmore-desktop --lib clipboard::mac::events::tests -- --ignored",
    "test:models:download": "cargo test -p speakmore-desktop --lib signed_download_sqlite_reopen_and_real_worker -- --ignored --nocapture",
    "test:models:import": "cargo test -p speakmore-desktop --lib offline_import_both_engines_sqlite_reopen_and_real_worker -- --ignored --nocapture --test-threads=1",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:audit": "node scripts/build-target-audit.mjs",
    "desktop:model-check": "node scripts/build-model-check.mjs",
    "test:session": "cargo build -p speakmore-worker-supervisor --features test-fixtures --bin speakmore-supervisor-fixture && cargo test -p speakmore-desktop --features session-fixtures --lib",
    "test:session:asr": "cargo test -p speakmore-desktop --features session-fixtures --lib real_worker_public_speech_through_actor -- --ignored --nocapture",
    "test:asr:sensevoice": "cargo test -p speakmore-asr-worker --no-default-features --features sensevoice --test sensevoice_process -- --include-ignored --nocapture --test-threads=1",
    "test:asr:sensevoice:tiled": "cargo test --offline -p speakmore-asr-worker --features sensevoice --test sensevoice_tiled -- --ignored --nocapture --test-threads=1",
    "test:sensevoice:native": "cargo test -p speakmore-sensevoice --test native -- --ignored --nocapture --test-threads=1",
    "test:models:sensevoice": "cargo test -p speakmore-desktop --lib signed_sensevoice_download_sqlite_reopen_and_real_worker -- --ignored --nocapture",
    "test:session:sensevoice": "cargo test -p speakmore-desktop --features session-fixtures --lib real_sensevoice_whisper_switch_through_actor -- --ignored --nocapture",
    "test:license": "cargo test -p speakmore-license"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "motion": "^12.23.24",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
